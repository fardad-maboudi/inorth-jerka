{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "*": [
        "./*"
      ]
    },
    "checkJs": false,
    "allowJs": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "types": [
      "react",
      "react-dom"
    ],
    "skipLibCheck": false
  },
  "include": [
    "src"
  ]
}
